# Krypton Bot Light needs no configuration: `npm install && npm run dev` just works.
# Copy this file to .env only if you want to change something. Never commit .env.

# Where the embedded database and the local encryption key live (default ./data).
# DATA_DIR=./data

# Port for `npm run dev` / `npm start` (default 3000). The server binds to 127.0.0.1 only.
# PORT=3000

# --- Live trading (optional) -------------------------------------------------
# Your own Polymarket signer key. Prefer a dedicated wallet holding only what you can afford to lose.
# You can also paste it in Settings, where it is stored encrypted in ./data. Never share this value.
# POLYMARKET_PRIVATE_KEY=0x...
# Only if your funds sit in a different (proxy / Safe) wallet than the signer:
# POLYMARKET_FUNDER=0x...

# --- Alerts (optional) -------------------------------------------------------
# Token of YOUR Telegram bot from @BotFather. Or paste it in Settings.
# TELEGRAM_BOT_TOKEN=

# --- Advanced ------------------------------------------------------------------
# 64 hex characters (openssl rand -hex 32). If unset, a random key is generated in ./data/.secret.
# CREDENTIALS_KEY=
# Extra hostnames the app may answer to (comma separated), e.g. behind your own authenticated reverse proxy.
# The app has no login, so do not expose it to the internet without one.
# ALLOWED_HOSTS=
